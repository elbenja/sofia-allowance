# Copy this file to .env.local for `npm run dev`, and add the same names in
# Vercel > Settings > Environment Variables.

# ── Server-only secrets. None of these is ever sent to the browser. ──

# The password for the whole site.
password=
# The parent PIN that unlocks adding and removing chores.
parent_pin=
# The web-app link from the Apps Script deployment.
sheet_url=
# A long random secret; the same value goes in the script's PARENT_PIN property.
sheet_key=

# ── Shown on the page, so not secrets (the VITE_ prefix sends them to the browser). ──

# Who the app is for. Optional: without it the page says "Hi there" and "Allowance".
VITE_KID_NAME=
# A link to a square picture for the avatar. Optional: without it the avatar shows
# the name's first letter.
VITE_AVATAR_URL=
# A link to a square picture for the browser-tab icon. Optional: without it the tab
# shows the plush dog in public/favicon.png.
VITE_FAVICON_URL=
